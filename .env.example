# Passcode for the app's lock screen. Any string; you'll type it on your phone.
APP_PASSCODE=change-me

# 32-byte hex key used to encrypt the SimpleFIN access URL at rest.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Session cookie signing secret.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Hours before cached balances are considered stale and revalidated in the background.
CACHE_TTL_HOURS=12

# Hard ceiling on SimpleFIN requests per day. Their limit is 24; stay under it.
MAX_DAILY_REQUESTS=20

# Deadline for a single SimpleFIN request. Without one, a connection the Bridge accepts
# and then never answers on holds the sync open indefinitely and blocks every later one.
SIMPLEFIN_TIMEOUT_MS=45000

# Local time used for the nightly snapshot job.
TZ=UTC

PORT=3000
DATABASE_PATH=./data/ledgerline.db
